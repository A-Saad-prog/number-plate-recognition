DATABASE_URL=postgresql://username:password@localhost:5432/parking_garage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin password recovery / MFA
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# HMAC pepper for hashing email OTPs at rest -- generate a long random value.
AUTH_RECOVERY_PEPPER=

# Fernet key for encrypting TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173

# Development only: logs OTPs instead of failing when SMTP isn't configured.
# Must be false (or unset) in production.
AUTH_DEV_SHOW_OTP=false